{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "userCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "products": {
        "ClusterId": "catalogCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "categories": {
        "ClusterId": "catalogCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "carts": {
        "ClusterId": "cartCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/carts/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orderCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "paymentCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "inventories": {
        "ClusterId": "inventoryCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/api/inventories/{**catch-all}" }
      },
      "images": {
        "ClusterId": "catalogCluster",
        "CorsPolicy": "AllowReactApp",
        "Match": { "Path": "/images/{**catch-all}" }
      }
    },
    "Clusters": {
      "userCluster": { "Destinations": { "d1": { "Address": "https://localhost:7082" } } },
      "catalogCluster": { "Destinations": { "d1": { "Address": "https://localhost:7038" } } },
      "cartCluster": { "Destinations": { "d1": { "Address": "https://localhost:7252" } } },
      "orderCluster": { "Destinations": { "d1": { "Address": "https://localhost:7015" } } },
      "paymentCluster": { "Destinations": { "d1": { "Address": "https://localhost:7213" } } },
      "inventoryCluster": { "Destinations": { "d1": { "Address": "https://localhost:7264" } } }
    }
  }
}
